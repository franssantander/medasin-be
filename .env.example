APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:82

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register the public /api/v1/auth/google/callback URI with Google, without query parameters.
# Initiation and callback must use the same public host, including API proxies.
GOOGLE_REDIRECT_URI=
# Leave empty for a JSON callback; set the frontend /login URI for browser sign-in.
GOOGLE_FRONTEND_REDIRECT_URI=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Docker startup flags must be injected through Compose environment settings.
# Apply pending migrations and repeatable seeds without resetting the database.
RUN_MIGRATIONS=false
RUN_SEEDERS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
API_READ_CACHE_ENABLED=true
API_READ_CACHE_STORE=api_reads
API_READ_CACHE_TTL=60
API_PLAN_CACHE_TTL=600
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Compose overrides these with redis:6379 for the PHP services.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_TIMEOUT=1
REDIS_CACHE_READ_TIMEOUT=1
REDIS_CACHE_MAX_RETRIES=0

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
